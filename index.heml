<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>放置天堂 - 賭場/商城 MOD 書籤小工具 v2</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #f1f5f9; padding: 20px; line-height: 1.6; }
    .box { background: #1e293b; border: 2px solid #38bdf8; border-radius: 12px; padding: 24px; max-width: 600px; margin: 0 auto; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
    h2 { color: #facc15; margin-top: 0; font-size: 20px; }
    .bookmarklet { display: inline-block; background: #7c3aed; color: white; padding: 14px 24px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 16px; cursor: grab; margin: 16px 0; border: 1px solid #a78bfa; text-align: center; }
    .copy-btn { display: block; width: 100%; background: #0284c7; color: white; border: none; padding: 14px; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer; margin-top: 15px; box-sizing: border-box; }
    .copy-btn:active { background: #0369a1; }
    ol { padding-left: 20px; }
    code { background: #0f172a; padding: 2px 6px; border-radius: 4px; color: #38bdf8; word-break: break-all; }
    .mobile-sec { background: #0f172a; padding: 15px; border-radius: 8px; margin-top: 20px; border: 1px dashed #475569; }
    
    /* 隱藏輔助複製用文字框 */
    #hiddenCode { position: absolute; left: -9999px; opacity: 0; }

    /* 手機螢幕優化：自動隱藏電腦專用的拖拽按鈕 */
    @media (max-width: 640px) {
      .pc-only { display: none !important; }
    }
  </style>
</head>
<body>

<div class="box">
  <h2>🎰 放置天堂 賭場/商城 MOD 書籤小工具 v2</h2>
  <p style="color:#fbbf24; font-size: 14px;">v2 版本修復了換行問題，支援一鍵複製與遠端自動更新。</p>

  <!-- 電腦專用 (手機會自動隱藏) -->
  <a class="bookmarklet pc-only" id="modLink" href="#">🎰 放置天堂賭場商城MOD v2 (拖我到書籤列)</a>

  <!-- 手機/通用複製區塊 -->
  <div class="mobile-sec">
    <strong style="color:#38bdf8;">📱 手機安裝步驟：</strong>
    <button class="copy-btn" onclick="copyCode()">📋 點此複製 MOD 代碼</button>
    <textarea id="hiddenCode" readonly></textarea>
    <ol style="font-size: 14px; margin-bottom: 0; margin-top: 10px;">
      <li>點擊上方按鈕複製代碼。</li>
      <li>將本網頁加入瀏覽器書籤，名稱改為 <code>MOD</code>。</li>
      <li>編輯該書籤，將網址 (URL) 清空並<b>貼上剛複製的代碼</b>。</li>
      <li>在遊戲頁面點擊該書籤即可啟動 MOD！</li>
    </ol>
  </div>
</div>

<script>
  const code = `javascript:fetch('https://raw.githubusercontent.com/jack1988520-pixel/casino.js/main/casino.js').then(r=>r.text()).then(eval)`;
  
  // 設定電腦按鈕連結
  document.getElementById('modLink').href = code;
  document.getElementById('hiddenCode').value = code;

  // 強化版一鍵複製 (兼具現代 API 與舊版降級相容)
  function copyCode() {
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(code).then(showSuccess).catch(fallbackCopy);
    } else {
      fallbackCopy();
    }
  }

  function fallbackCopy() {
    const textarea = document.getElementById('hiddenCode');
    textarea.select();
    textarea.setSelectionRange(0, 99999); // 針對 iOS 設備選取
    try {
      document.execCommand('copy');
      showSuccess();
    } catch (err) {
      alert('複製失敗，請手動複製代碼。');
    }
  }

  function showSuccess() {
    alert('✅ 已成功複製 MOD 代碼！\n\n請前往編輯瀏覽器書籤，將網址貼上即可。');
  }
</script>

</body>
</html>
